{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "ChannelVault",
  "outputfilename": "ChannelVault",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "mestr.io",
    "email": "info@mestr.io"
  },
  "runNonNativeBuildHooks": true,
  "preBuildHooks": {
    "darwin/universal": "sh ../../prebuild.sh macOS",
    "linux/amd64": "sh ../../prebuild.sh linux"
    "windows/amd64": "sh ../../prebuild.sh win"
  },
  "postBuildHooks": {
    "darwin/universal": "sh ../../postbuild.sh macOS",
    "linux/amd64": "sh ../../postbuild.sh linux"
    "windows/amd64": "sh ../../postbuild.sh win"
  },
  "info": {
    "companyName": "mestrio",
    "productName": "ChannelVault",
    "productVersion": "0.0.1"
  }
}
